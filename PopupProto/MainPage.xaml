<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PopupProto.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Button Clicked="OnSimpleButtonClicked"
                    HorizontalOptions="Fill"
                    Text="Simple Popup" />

            <Button Clicked="OnMessagePopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Message Popup" />

            <Button Clicked="OnAddPopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Add Popup" />

            <Button Clicked="OnReturnObjectPopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Return Object Popup" />

            <Button Clicked="OnLoadingPopups_Clicked"
                    HorizontalOptions="Fill"
                    Text="Loading Popups" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
